# Docker Compose values
MYSQL_DATABASE=miragehunter
MYSQL_USER=miragehunter
MYSQL_PASSWORD=change-me-local
MYSQL_ROOT_PASSWORD=change-me-root-local
MYSQL_PORT=3306

# Frontend Vite build-time value. Use /api for the Docker/Nginx deployment.
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT_MS=5000

# Backend local defaults. Docker Compose overrides these with service hostnames.
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
AI_SERVICE_BASE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT_MS=3000

# AI service
AI_SERVICE_NAME=ai-service
AI_LOG_LEVEL=INFO
